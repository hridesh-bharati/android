rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==================== HELPERS ==================== */
    function isLoggedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return [
        "hridesh027@gmail.com",
        "ajaytiwari4@gmail.com",
        "chauhansantosh045@gmail.com"
      ];
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isLoggedIn() && (
        request.auth.token.email in adminEmails() ||
        (userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    /* ==================== USERS ==================== */
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if isLoggedIn();
      allow update, delete: if isLoggedIn() && (isOwner(userId) || isAdmin());
    }

    match /publicAdmins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==================== EXAM SYSTEM ==================== */
    match /exams/{examId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    match /examQuestions/{questionId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }
    match /masterQuestions/{questionId} {
      allow read: if isLoggedIn(); 
      allow write: if isAdmin();
    }

    /* ==================== STUDENT PERFORMANCE ==================== */
    match /studentExams/{studentExamId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isLoggedIn() && (
        isAdmin() || (
          resource.data.studentId == request.auth.token.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'startedAt', 'answers', 'completedAt', 'score'])
        )
      );
    }

    /* ==================== ADMISSIONS & PAYMENTS ==================== */
    match /admissions/{emailId} {
      allow read: if true; 
      allow create: if isAdmin() || request.resource.data.status == "pending";
      allow update: if isAdmin() || (
        isLoggedIn() && 
        request.auth.token.email.lower() == emailId.lower()
      );
      allow delete: if isAdmin();
      
     match /payments/{paymentId} {
        allow read: if true; 
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    /* ==================== STUDENTS & ATTENDANCE ==================== */
    match /students/{studentId} {
      allow read: if isLoggedIn(); 
      allow write: if isAdmin();
    }

    match /manual_attendance_stats/{studentId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    
    match /attendance/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    
    /* ==================== QUERIES & DOWNLOADS ==================== */
    match /studentQueries/{queryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow create: if isLoggedIn();
      allow read, delete: if isAdmin();
    }

    /* ==================== GALLERY & OFFERS ==================== */
    match /galleryImages/{docId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (isAdmin() || resource.data.uploadedById == request.auth.uid);
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.uploadedById == request.auth.uid);
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn(); 
        allow delete: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      }
    }
    
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && (request.auth.uid == resource.data.senderId || isAdmin());
    }

match /typingStatus/{userId} {
  allow read: if request.auth != null;
  allow write: if request.auth != null && request.auth.uid == userId;
}


    /* ==================== STATS ==================== */ 
    match /stats/{docId} {
      allow read: if docId == "visitors";
      allow update: if docId == "visitors" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
      allow write: if isAdmin();
    }

    /* =================== PRACTICE SYSTEM =================== */
    match /practiceAssigned/{id} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    match /practiceResults/{id} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isAdmin();
    }

    match /practiceTests/{testId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /practiceQuestions/{qId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    /* ==================== NOTES & LIBRARY ==================== */
    match /notes/{noteId} {
      allow read: if true;      
      allow write: if isAdmin(); 
    }

    /* ==================== BIRTHDAY WISHES ==================== */
    match /birthdayWishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.name != null && request.resource.data.message != null;
      allow delete: if isAdmin(); 
      allow update: if isAdmin();
    }

/* ==================== INQUIRIES Home button ==================== */
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    /* ==================== DEFAULT DENY ==================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}